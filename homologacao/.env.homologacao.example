# ============================================================================
# ARCHÉ — Variáveis de ambiente de HOMOLOGAÇÃO
# Separação TOTAL da produção: projeto Supabase próprio, chaves próprias,
# salts próprios. Nada aqui pode reutilizar valores de produção.
# ============================================================================

# ---- SUPABASE (do projeto NOVO de homologação; Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO-HOMOLOG.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-a-anon-key-do-projeto-de-homolog
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-do-projeto-de-homolog

# ---- SITE ----
NEXT_PUBLIC_SITE_URL=https://SEU-PREVIEW.vercel.app

# ---- SALTS/SEGREDOS (gere NOVOS: `openssl rand -hex 32`; NÃO copie da produção) ----
IP_HASH_SALT=gere-um-novo-aleatorio-so-para-homolog
CRON_SECRET=gere-um-novo-aleatorio-so-para-homolog

# ---- E-MAIL: DEIXE VAZIO EM HOMOLOGAÇÃO ----
# Sem RESEND_API_KEY o código vira no-op (loga e NÃO envia) — garantia de que
# nenhuma notificação atinge destinatário real. NÃO preencha estas três:
# RESEND_API_KEY=
# EMAIL_FROM=
# EMAIL_NOTIF_TO=

# ---- IA (opcional; só se quiser testar os fluxos de IA em homolog) ----
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- RATE LIMIT (opcional; sem isso vira no-op, ok para homolog) ----
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
